{
  "format": "brume-controller-profile/1",
  "name": "Korg nanoKONTROL2 (factory CC mode)",
  "description": "8 knobs → Complex morph + FM controls. 8 sliders → filter envelope + master volume. Buttons deferred to a paired Lua script.",
  "controller_setup": "Set the nanoKONTROL2 to factory CC Mode (the default preset). LED Mode = External. The device sends on MIDI channel 1; Brume's default channel routing sends channel 1 to the Complex part, so all knob/slider movements affect Complex.",
  "author": "Aftertone",
  "match": {
    "port_name_contains": ["nanoKONTROL2"]
  },
  "matrix": {
    "channel_map": {
      "channel_to_part": [0, 1, 2, 3, null, null, null, null, null, null, null, null, null, null, null, null]
    },
    "bindings": [
      { "cc_number": 16, "channel_filter": 0, "destination": "CarrierMorph",     "range_min": 0.0,  "range_max": 1.0 },
      { "cc_number": 17, "channel_filter": 0, "destination": "ModulatorMorph",   "range_min": 0.0,  "range_max": 1.0 },
      { "cc_number": 18, "channel_filter": 0, "destination": "ModulatorRatio",   "range_min": 0.5,  "range_max": 16.0 },
      { "cc_number": 19, "channel_filter": 0, "destination": "FmIndex",          "range_min": 0.0,  "range_max": 10.0 },
      { "cc_number": 20, "channel_filter": 0, "destination": "CrossFmDepth",     "range_min": 0.0,  "range_max": 1.0 },
      { "cc_number": 21, "channel_filter": 0, "destination": "FoldAmount",       "range_min": 0.0,  "range_max": 1.0 },
      { "cc_number": 22, "channel_filter": 0, "destination": "ModFoldAmount",    "range_min": 0.0,  "range_max": 1.0 },
      { "cc_number": 23, "channel_filter": 0, "destination": "Angle",            "range_min": 0.0,  "range_max": 1.0 },

      { "cc_number": 0,  "channel_filter": 0, "destination": "FilterEnvAttack",  "range_min": 0.0,  "range_max": 1.0 },
      { "cc_number": 1,  "channel_filter": 0, "destination": "FilterCutoff",     "range_min": 20.0, "range_max": 20000.0 },
      { "cc_number": 2,  "channel_filter": 0, "destination": "FilterResonance",  "range_min": 0.0,  "range_max": 1.0 },
      { "cc_number": 3,  "channel_filter": 0, "destination": "FilterEnvDecay",   "range_min": 0.0,  "range_max": 1.0 },
      { "cc_number": 4,  "channel_filter": 0, "destination": "FilterEnvSustain", "range_min": 0.0,  "range_max": 1.0 },
      { "cc_number": 5,  "channel_filter": 0, "destination": "FilterEnvRelease", "range_min": 0.0,  "range_max": 1.0 },
      { "cc_number": 6,  "channel_filter": 0, "destination": "FilterEnvDepth",   "range_min": 0.0,  "range_max": 1.0 },
      { "cc_number": 7,  "channel_filter": 0, "destination": "MasterVolume",     "range_min": 0.0,  "range_max": 1.0 }
    ],
    "fx_bindings": []
  }
}
